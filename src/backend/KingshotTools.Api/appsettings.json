{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Azure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cosmos": {
    "ConnectionString": "",
    "DatabaseName": "kingshot",
    "EnsureCreatedOnStartup": false,
    "UseEmulatorConnectionMode": false
  },
  "Blob": {
    "ConnectionString": "",
    "RawFramesContainer": "raw-frames",
    "EnsureCreatedOnStartup": false
  },
  "Ingest": {
    "QueueCapacity": 1000,
    "MaxMessageBytes": 4194304,
    "ArchiveRawFrames": true,
    "SchemaBundlePath": null
  },
  "Live": {
    "ChangeFeedEnabled": true,
    "ProcessorName": "worldState-to-signalr"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
